# Bu fayldan nusxa olib, ".env.local" deb nomlang (faqat kompyuterda sinash uchun).
# Vercel'da bu qiymatlar Settings -> Environment Variables bo'limida kiritiladi.

# O'qituvchi paneli paroli (majburiy: busiz panel ishlamaydi)
ADMIN_PASSWORD=bu-yerga-kuchli-parol-yozing

# Har bir talabaga beriladigan savollar soni (standart: 20)
QUIZ_QUESTION_COUNT=20

# Test uchun vaqt, daqiqada (standart: 20)
QUIZ_TIME_MINUTES=20

# Ma'lumotlar bazasi (Upstash Redis). Vercel'da "Upstash for Redis" ulansa,
# bu qiymatlar avtomatik qo'shiladi (KV_REST_API_URL / KV_REST_API_TOKEN nomlari ham ishlaydi).
# Lokal sinovda bo'sh qoldirish mumkin: natijalar vaqtincha xotirada saqlanadi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
