# Bu fayldan nusxa olib, ".env.local" deb nomlang (faqat kompyuterda sinash uchun).
# Vercel'da bu qiymatlar Settings -> Environment Variables bo'limida kiritiladi.

# O'qituvchi paneli paroli (majburiy: busiz panel ishlamaydi)
ADMIN_PASSWORD=bu-yerga-kuchli-parol-yozing

# Stateless rejimda urinish tokenini imzolash uchun maxfiy kalit.
# Tavsiya: productionda alohida uzun qiymat bering.
# ATTEMPT_SECRET bo'sh bo'lsa, ADMIN_PASSWORD fallback sifatida ishlatiladi.
ATTEMPT_SECRET=

# Har bir talabaga beriladigan savollar soni (standart: 80)
QUIZ_QUESTION_COUNT=80

# Test uchun vaqt, daqiqada (standart: 20)
QUIZ_TIME_MINUTES=20

# Ma'lumotlar bazasi (ixtiyoriy): Upstash Redis.
# Ulangan bo'lsa: umumiy jadval, CSV va o'qituvchi paneli to'liq ishlaydi.
# Ulanmagan bo'lsa: ilova stateless rejimda ishlaydi (umumiy jadval saqlanmaydi).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Faqat lokal diagnostika uchun: xotira fallback'ni yoqish.
# Qiymat "memory" bo'lsa, Redis bo'lmaganda natijalar process xotirasida saqlanadi.
QUIZ_STORAGE_MODE=

# Live rejimni majburiy qilish uchun 1 qilib qo'ying.
# 1 bo'lsa va Redis ulanmagan bo'lsa, ilova testni boshlatmaydi (503 qaytaradi).
QUIZ_FORCE_REDIS=
